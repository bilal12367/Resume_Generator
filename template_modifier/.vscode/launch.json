{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run Current File as Module",
      "type": "debugpy",
      "request": "launch",
      "module": "${relativeFileDirname}.${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}