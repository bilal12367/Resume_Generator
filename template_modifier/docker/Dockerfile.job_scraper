FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for Playwright Chromium (needed by mcps/linkedin_platform.py)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files first (cache layer)
COPY pyproject.toml uv.lock ./

# Create virtual environment and install dependencies
RUN uv sync --no-dev

# Install Playwright Chromium browser (required by mcps/linkedin_platform.py import)
RUN uv run python -m playwright install chromium

# Copy application source code
COPY module_testing/ ./module_testing/
COPY llm_enhancement/ ./llm_enhancement/
COPY dev_containers/__init__.py dev_containers/connect.py ./dev_containers/
COPY mcps/ ./mcps/
COPY generate_resume.py ./

# Copy template directory (needed for PDF generation)
COPY template/ ./template/

# Create necessary directories
RUN mkdir -p output user_data

EXPOSE 8080

ENV JOB_SCRAPER_PORT=8080
ENV MCP_URL=http://mcp:8000/sse
ENV CENTRIFUGE_BASE_URL=http://centrifugo:8000

CMD ["uv", "run", "-m", "module_testing.job_scraper"]
